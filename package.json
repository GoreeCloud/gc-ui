{
  "name": "@goreecloud/gc-ui",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "GoreeCloud UI (GC UI) — GoreeCloud's original adaptive interface design language",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run tokens:check && npm test && npm run audit:colors && node tests/check-lab-references.mjs && npm run pack:check",
    "tokens:build": "node scripts/build-v1-tokens.mjs",
    "tokens:check": "node scripts/build-v1-tokens.mjs --check",
    "audit:colors": "node scripts/audit-colors.mjs",
    "test:e2e": "npm run test:e2e:interaction && npm run test:e2e:reflow && npm run test:e2e:accessibility && npm run test:e2e:visual",
    "test:e2e:interaction": "playwright test e2e/gc-ui.spec.mjs e2e/adaptive.spec.mjs e2e/forms.spec.mjs",
    "test:e2e:visual": "playwright test e2e/visual-capture.spec.mjs e2e/adaptive-visual.spec.mjs e2e/forms-visual.spec.mjs --workers=1 --timeout=90000",
    "test:e2e:firefox": "playwright test e2e/gc-ui.spec.mjs e2e/adaptive.spec.mjs e2e/forms.spec.mjs --browser firefox --workers=1",
    "test:e2e:accessibility": "playwright test e2e/accessibility.spec.mjs --workers=1",
    "pack:check": "node scripts/check-pack-manifest.mjs",
    "test:e2e:reflow": "playwright test e2e/reflow.spec.mjs --workers=1"
  },
  "license": "UNLICENSED",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./tokens": "./tokens/gc.v1.tokens.json",
    "./css/tokens": "./styles/gc.v1.generated.css",
    "./css/components": "./styles/gc.v1.components.css",
    "./icons": "./assets/gc-glyphs.svg",
    "./registry": "./registry/components.v1.json",
    "./css/navigation": "./styles/gc.v1.navigation.css",
    "./brand/icon": "./assets/gc-mark.svg",
    "./brand/symbol": "./assets/gc-symbol.svg",
    "./brand/logo": "./assets/gc-logo.svg",
    "./brand/logo-dark": "./assets/gc-logo-dark.svg"
  },
  "files": [
    "src",
    "types",
    "styles/gc.v1.generated.css",
    "styles/gc.v1.components.css",
    "tokens/gc.v1.tokens.json",
    "assets/gc-glyphs.svg",
    "README.md",
    "docs",
    "registry/components.v1.json",
    "styles/gc.v1.navigation.css",
    "assets/gc-mark.svg",
    "assets/gc-symbol.svg",
    "assets/gc-logo.svg",
    "assets/gc-logo-dark.svg"
  ],
  "sideEffects": [
    "./styles/*.css"
  ]
}
