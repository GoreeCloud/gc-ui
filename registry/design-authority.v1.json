{
  "schemaVersion": 1,
  "authority": "GoreeCloud UI",
  "abbreviation": "GC UI",
  "status": "alpha-implementation",
  "mandatoryFor": [
    "GoreeCloud-controlled web interfaces",
    "GoreeCloud apps",
    "GoreeCloud dashboards",
    "GoreeCloud OS interfaces where applicable"
  ],
  "designPhilosophy": "Clear by default. Consistent by nature. Fluid by design.",
  "designPromise": "Calm information. Expressive personality. Purposeful depth.",
  "implementation": {
    "tokens": "tokens/gc.tokens.json",
    "css": "src/tokens.css",
    "components": "src/components.css",
    "componentDocs": "docs/COMPONENTS.md",
    "designDocs": "docs/DESIGN_LANGUAGE.md",
    "visualQualityDocs": "docs/VISUAL_QUALITY.md",
    "windowsAndNavigationDocs": "docs/WINDOWS_AND_NAVIGATION.md"
  },
  "materials": [
    "Cloud Canvas",
    "Cloud Surface",
    "Cloud Lens"
  ],
  "accentFamilies": [
    "iris",
    "lagoon",
    "ember",
    "moss"
  ],
  "appearances": [
    "light",
    "dark",
    "auto"
  ],
  "contrastModes": [
    "normal",
    "more"
  ],
  "requiredReview": [
    "token use",
    "information hierarchy",
    "premium visual quality",
    "responsive behavior",
    "keyboard/accessibility",
    "loading and failure states",
    "contrast",
    "motion/transparency fallbacks",
    "real platform evidence",
    "whole-shell-and-sidebar-craftsmanship",
    "anti-AI-slop-and-template-originality"
  ],
  "tokenValuesStatus": "provisional-alpha-candidates",
  "nativeSdkStatus": "not-implemented",
  "consumerMigrationStatus": "not-audited",
  "designInfluences": [
    "ergonomic information hierarchy",
    "adaptive semantic color",
    "purposeful translucent depth"
  ],
  "privacy": {
    "telemetry": "none",
    "persistence": "opt-in to consumer"
  },
  "license": "MIT",
  "upstreamGovernance": "GoreeCloud/Projects/GoreeCloud UI/DESIGN-LANGUAGE-AND-100-UI-UX-PRINCIPLES.md",
  "visualQuality": {
    "requirement": "mandatory",
    "identity": "distinctive-premium-modern",
    "acceptance": "per-consumer-evidence-required",
    "nativeStatus": "unverified",
    "supportedModes": [
      "light",
      "dark",
      "high-contrast",
      "reduced-motion",
      "reduced-transparency"
    ],
    "guardrails": [
      "opaque-essential-reading",
      "semantic-roles-only",
      "original-visual-language",
      "no-inert-interactions"
    ],
    "craftsmanshipReview": {
      "requirement": "mandatory-whole-experience",
      "founderStandard": "https://drive.google.com/file/d/1IAcE_0j-FGu_qi3nhzfHvDINfuI_lVVR/view",
      "prohibitedOutcomes": [
        "generic-or-repetitive-templates",
        "unrefined-shell-or-sidebar",
        "purposeless-gradient-glow-or-glass",
        "inconsistent-typography-and-icons",
        "polish-confined-to-showcase-screen",
        "inert-or-deceptive-controls"
      ],
      "reviewScopes": [
        "shell-and-sidebar",
        "navigation-and-components",
        "end-to-end-states",
        "responsive-and-zoom",
        "theme-and-accessibility-modes"
      ],
      "requiredEvidence": "rendered-visual-review-plus-functional-regressions",
      "adoptionStatus": "per-consumer-unverified"
    }
  },
  "windowShape": {
    "requirement": "rounded-all-windows",
    "webComponents": "implemented-alpha",
    "radiusRole": "radius.xl",
    "compactRadiusRole": "radius.lg",
    "nativeEnforcement": "requires-platform-adapters",
    "nativeStatus": "unverified",
    "webAppShell": "gc-window--app-shell"
  },
  "bottomNavigation": {
    "requirement": "floating-at-application-bottom",
    "material": "Cloud Lens",
    "webController": "implemented-alpha",
    "safeArea": "required",
    "keyboard": "arrow-home-end-rtl-aware",
    "nativeEnforcement": "requires-platform-adapters",
    "nativeStatus": "unverified",
    "webContexts": [
      "viewport",
      "window-scoped"
    ],
    "webWindowShellClass": "gc-window--app-shell",
    "webWindowDockClass": "gc-bottom-nav--window",
    "consumerPattern": "choose-one-context-no-duplicate-docks"
  },
  "colorPolicy": {
    "mandatoryGlobalHue": false,
    "curatedPresets": "optional-illustrative",
    "independentApplicationChoices": true,
    "userAccentOverrides": "honor-when-authorized",
    "accessibility": [
      "semantic-color-roles",
      "contrast",
      "visible-focus",
      "forced-colors-fallbacks"
    ],
    "nativeProductAdoption": "not-audited",
    "mandatoryAppearanceTheme": false,
    "independentApplicationAppearance": true,
    "webThemeScope": "document-root-or-configured-gc-app",
    "themeScopeStatus": "web-alpha-consumer-adoption-not-audited"
  },
  "navigationRail": {
    "requirement": "tablet-desktop-web-collapsible-icon-only",
    "expandedDefault": "desktop-at-least-1024-css-px",
    "collapsedDefault": "tablet-601-to-1023-css-px",
    "compactWidth": "76px-web-alpha-default",
    "expandedWidth": "248px-web-alpha-default",
    "phone": "hide-rail-use-context-appropriate-bottom-navigation",
    "webController": "implemented-alpha",
    "nativeStatus": "requires-native-adapters",
    "acceptance": "per-consumer-evidence-required",
    "privacy": "no-storage-no-telemetry"
  },
  "desktopWindowing": {
    "requirement": "normal-windowed-by-default",
    "platforms": [
      "linux",
      "windows",
      "macos"
    ],
    "firstLaunchState": "normal",
    "maximize": "user-invoked-native-action",
    "fullscreen": "user-invoked-native-action",
    "restoreSavedState": "only-explicit-user-choice-when-supported",
    "onDisplayChange": "clamp-normal-window-to-available-work-area",
    "secondaryWindows": "native-transient-no-forced-immersive-state",
    "integrationStatus": "native-consumer-validation-required",
    "docs": "docs/PLATFORM_ADAPTERS.md",
    "nativeSdkStatus": "not-implemented",
    "webStableScope": "not-applicable"
  },
  "linuxPrimaryUiFrameworks": {
    "policy": "registry/linux-primary-ui-frameworks.v1.json",
    "docs": "docs/LINUX_UI_FRAMEWORKS.md",
    "status": "mandatory-existing-and-future-applications",
    "nativeConsumerCompliance": "migration-required-for-verified-legacy-clients",
    "masterDriveReconciliation": "verified-targeted",
    "masterGovernanceSection": "14.2B"
  },
  "androidDesignFoundation": {
    "requirement": "material-3-expressive",
    "mandateStatus": "founder-directed-2026-11-20",
    "governingDesignAuthority": "GoreeCloud UI",
    "reference": "docs/ANDROID_MATERIAL3_EXPRESSIVE.md",
    "canonicalTokens": "tokens/gc.tokens.json",
    "nativeComposeSource": "android/material3-expressive/gc-ui-compose",
    "upstreamLibrary": "androidx.compose.material3:material3:1.5.0",
    "androidOnlyDefaultFramework": "Jetpack Compose + Kotlin",
    "permittedFrameworks": [
      "Jetpack Compose + Kotlin",
      "Flutter",
      "React Native + Expo",
      "Kotlin Multiplatform + Compose Multiplatform"
    ],
    "sourceStatus": "alpha-source-on-main",
    "libraryBuildStatus": "github-actions-pr-162-compiled-successfully",
    "libraryBuildEvidence": "https://github.com/GoreeCloud/gc-ui/actions/runs/44700423037",
    "deviceAcceptance": "not-verified",
    "downstreamAdoption": "not-completed",
    "requiredBehavior": [
      "canonical-semantic-color",
      "light-dark-modes",
      "expressive-motion-and-reduced-motion",
      "rounded-surfaces",
      "floating-inset-navigation",
      "adaptive-large-screens",
      "talkback-and-contrast",
      "explicit-dynamic-color-opt-in"
    ]
  },
  "windowCommandNodes": {
    "officialName": "GoreeCloud UI Window Command Nodes",
    "abbreviation": "WCN",
    "shortName": "Command Nodes",
    "status": "founder-approved-circular-design-web-alpha-implementation",
    "approvedOn": "2026-11-14",
    "titlebarAlignment": "physical-right",
    "visualTreatment": "flat",
    "visibleGlyphs": false,
    "actionSymbols": false,
    "controls": [
      {
        "name": "Crimson Node",
        "action": "Dismiss",
        "windowOperation": "close"
      },
      {
        "name": "Amber Node",
        "action": "Dock",
        "windowOperation": "minimize-to-workspace-dock"
      },
      {
        "name": "Teal Node",
        "action": "Expand",
        "windowOperation": "maximize-or-restore"
      }
    ],
    "colorHexValues": "tokens/gc.tokens.json#windowCommandNodes.colors",
    "shapeGeometry": "circle",
    "nativeWindowActionsRequired": true,
    "accessibleNamesRequired": true,
    "appAccentIndependent": true,
    "docs": "docs/WINDOWS_AND_NAVIGATION.md",
    "adoptionStatus": "not-audited",
    "faceDiameter": "18px",
    "hitTarget": "44px",
    "gap": "0px",
    "paletteStatus": "implementation-candidate-pending-founder-visual-review",
    "webController": "src/window-command-nodes.js",
    "webControllerStatus": "implemented-alpha",
    "nativeAdapterStatus": "not-implemented"
  }
}
