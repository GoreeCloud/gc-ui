{
  "name": "@goreecloud/ui",
  "version": "0.1.0-alpha.0",
  "description": "GoreeCloud UI foundations, semantic tokens and accessible progressive web components",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./tokens": "./tokens/gc.tokens.json",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./icons": {
      "types": "./src/icons.d.ts",
      "default": "./src/icons.js"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./patterns": {
      "types": "./src/patterns.d.ts",
      "default": "./src/patterns.js"
    },
    "./icon-sprite": "./assets/gc-icons.svg",
    "./icon-registry": "./assets/gc-icons.json",
    "./commands": {
      "types": "./src/commands.d.ts",
      "default": "./src/commands.js"
    },
    "./menu": {
      "types": "./src/menu.d.ts",
      "default": "./src/menu.js"
    },
    "./table": {
      "types": "./src/table.d.ts",
      "default": "./src/table.js"
    },
    "./tree": {
      "types": "./src/tree.d.ts",
      "default": "./src/tree.js"
    }
  },
  "files": [
    "src/",
    "tokens/",
    "docs/",
    "registry/",
    "LICENSE",
    "README.md",
    "platform/generated/",
    "scripts/",
    "assets/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/theme.js && node --check src/icons.js && node --check src/elements.js && node --check src/patterns.js && node --check src/commands.js && node --check src/menu.js && node --check src/table.js && node --check src/tree.js && node --check scripts/generate-web-tokens.mjs && node --check scripts/build-icon-assets.mjs && npm run icons:check && npm run tokens:check && npm run export:platform && npm run export:check && npm run contrast:check && npm test",
    "export:platform": "node scripts/export-platform-tokens.mjs --write",
    "export:check": "node scripts/export-platform-tokens.mjs --check",
    "prepack": "npm run icons:check && npm run tokens:check && npm run export:platform",
    "tokens:generate": "node scripts/generate-web-tokens.mjs --write",
    "tokens:check": "node scripts/generate-web-tokens.mjs --check",
    "contrast:check": "node scripts/audit-contrast.mjs --check",
    "icons:generate": "node scripts/build-icon-assets.mjs --write",
    "icons:check": "node scripts/build-icon-assets.mjs --check",
    "browser:smoke": "node tests/browser-smoke.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
