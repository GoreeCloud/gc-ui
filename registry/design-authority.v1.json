{
  "schemaVersion": 1,
  "authority": "GoreeCloud UI",
  "abbreviation": "GC UI",
  "status": "alpha-implementation",
  "mandatoryFor": [
    "GoreeCloud-controlled web interfaces",
    "GoreeCloud apps",
    "GoreeCloud dashboards",
    "GoreeCloud OS interfaces where applicable"
  ],
  "designPhilosophy": "Clear by default. Consistent by nature. Fluid by design.",
  "designPromise": "Calm information. Expressive personality. Purposeful depth.",
  "implementation": {
    "tokens": "tokens/gc.tokens.json",
    "css": "src/tokens.css",
    "components": "src/components.css",
    "componentDocs": "docs/COMPONENTS.md",
    "designDocs": "docs/DESIGN_LANGUAGE.md",
    "visualQualityDocs": "docs/VISUAL_QUALITY.md",
    "windowsAndNavigationDocs": "docs/WINDOWS_AND_NAVIGATION.md"
  },
  "materials": [
    "Cloud Canvas",
    "Cloud Surface",
    "Cloud Lens"
  ],
  "accentFamilies": [
    "iris",
    "lagoon",
    "ember",
    "moss"
  ],
  "appearances": [
    "light",
    "dark",
    "auto"
  ],
  "contrastModes": [
    "normal",
    "more"
  ],
  "requiredReview": [
    "token use",
    "information hierarchy",
    "premium visual quality",
    "responsive behavior",
    "keyboard/accessibility",
    "loading and failure states",
    "contrast",
    "motion/transparency fallbacks",
    "real platform evidence"
  ],
  "tokenValuesStatus": "provisional-alpha-candidates",
  "nativeSdkStatus": "not-implemented",
  "consumerMigrationStatus": "not-audited",
  "designInfluences": [
    "ergonomic information hierarchy",
    "adaptive semantic color",
    "purposeful translucent depth"
  ],
  "privacy": {
    "telemetry": "none",
    "persistence": "opt-in to consumer"
  },
  "license": "MIT",
  "upstreamGovernance": "GoreeCloud/Projects/GoreeCloud UI/DESIGN-LANGUAGE-AND-100-UI-UX-PRINCIPLES.md",
  "visualQuality": {
    "requirement": "mandatory",
    "identity": "distinctive-premium-modern",
    "acceptance": "per-consumer-evidence-required",
    "nativeStatus": "unverified",
    "supportedModes": [
      "light",
      "dark",
      "high-contrast",
      "reduced-motion",
      "reduced-transparency"
    ],
    "guardrails": [
      "opaque-essential-reading",
      "semantic-roles-only",
      "original-visual-language",
      "no-inert-interactions"
    ]
  },
  "windowShape": {
    "requirement": "rounded-all-windows",
    "webComponents": "implemented-alpha",
    "radiusRole": "radius.xl",
    "compactRadiusRole": "radius.lg",
    "nativeEnforcement": "requires-platform-adapters",
    "nativeStatus": "unverified",
    "webAppShell": "gc-window--app-shell"
  },
  "bottomNavigation": {
    "requirement": "floating-at-application-bottom",
    "material": "Cloud Lens",
    "webController": "implemented-alpha",
    "safeArea": "required",
    "keyboard": "arrow-home-end-rtl-aware",
    "nativeEnforcement": "requires-platform-adapters",
    "nativeStatus": "unverified",
    "webContexts": [
      "viewport",
      "window-scoped"
    ],
    "webWindowShellClass": "gc-window--app-shell",
    "webWindowDockClass": "gc-bottom-nav--window",
    "consumerPattern": "choose-one-context-no-duplicate-docks"
  },
  "colorPolicy": {
    "mandatoryGlobalHue": false,
    "curatedPresets": "optional-illustrative",
    "independentApplicationChoices": true,
    "userAccentOverrides": "honor-when-authorized",
    "accessibility": [
      "semantic-color-roles",
      "contrast",
      "visible-focus",
      "forced-colors-fallbacks"
    ],
    "nativeProductAdoption": "not-audited",
    "mandatoryAppearanceTheme": false,
    "independentApplicationAppearance": true,
    "webThemeScope": "document-root-or-configured-gc-app",
    "themeScopeStatus": "web-alpha-consumer-adoption-not-audited"
  },
  "navigationRail": {
    "requirement": "tablet-desktop-web-collapsible-icon-only",
    "expandedDefault": "desktop-at-least-1024-css-px",
    "collapsedDefault": "tablet-601-to-1023-css-px",
    "compactWidth": "76px-web-alpha-default",
    "expandedWidth": "248px-web-alpha-default",
    "phone": "hide-rail-use-context-appropriate-bottom-navigation",
    "webController": "implemented-alpha",
    "nativeStatus": "requires-native-adapters",
    "acceptance": "per-consumer-evidence-required",
    "privacy": "no-storage-no-telemetry"
  },
  "desktopWindowing": {
    "requirement": "normal-windowed-by-default",
    "platforms": [
      "linux",
      "windows",
      "macos"
    ],
    "firstLaunchState": "normal",
    "maximize": "user-invoked-native-action",
    "fullscreen": "user-invoked-native-action",
    "restoreSavedState": "only-explicit-user-choice-when-supported",
    "onDisplayChange": "clamp-normal-window-to-available-work-area",
    "secondaryWindows": "native-transient-no-forced-immersive-state",
    "integrationStatus": "native-consumer-validation-required",
    "docs": "docs/PLATFORM_ADAPTERS.md",
    "nativeSdkStatus": "not-implemented",
    "webStableScope": "not-applicable"
  },
  "linuxPrimaryUiFrameworks": {
    "policy": "registry/linux-primary-ui-frameworks.v1.json",
    "docs": "docs/LINUX_UI_FRAMEWORKS.md",
    "status": "mandatory-existing-and-future-applications",
    "nativeConsumerCompliance": "migration-required-for-verified-legacy-clients",
    "masterDriveReconciliation": "verified-targeted",
    "masterGovernanceSection": "14.2B"
  }
}
