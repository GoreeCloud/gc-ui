{
  "name": "@goreecloud/gc-ui",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "GoreeCloud UI (GC UI) — GoreeCloud's original adaptive interface design language",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run icons:check && npm run authority:check && npm run migration:reconcile:check && npm run migration:cutover:readiness -- --check && npm run migration:handoff:check && npm run tokens:check && npm test && npm run audit:colors && npm run audit:composited && node tests/check-lab-references.mjs && npm run pack:check",
    "icons:build": "python3 scripts/build-third-party-sprite.py",
    "icons:check": "python3 scripts/build-third-party-sprite.py --check",
    "tokens:build": "node scripts/build-v1-tokens.mjs",
    "tokens:check": "node scripts/build-v1-tokens.mjs --check",
    "audit:colors": "node scripts/audit-colors.mjs",
    "audit:composited": "node scripts/audit-composited-contrast.mjs",
    "test:e2e:isolated": "node scripts/run-e2e-isolated.mjs",
    "test:e2e": "npm run test:e2e:interaction && npm run test:e2e:reflow && npm run test:e2e:effective-zoom && npm run test:e2e:accessibility && npm run qa:accessibility-evidence:verify && npm run qa:accessibility-evidence:stash && npm run test:e2e:visual && npm run qa:accessibility-evidence:restore",
    "pretest:e2e:interaction": "npm run release:foundations:verify",
    "test:e2e:interaction": "playwright test e2e/foundations-packaged.spec.mjs e2e/gc-ui.spec.mjs e2e/adaptive.spec.mjs e2e/forms.spec.mjs e2e/forms-solid-contrast.spec.mjs e2e/validation-summary.spec.mjs e2e/density-preview.spec.mjs e2e/balanced-surfaces.spec.mjs e2e/environment.spec.mjs e2e/composited-contrast.spec.mjs e2e/icon-atlas.spec.mjs e2e/pattern-workbench.spec.mjs e2e/motion-gallery.spec.mjs e2e/experience-studio.spec.mjs e2e/native-host.spec.mjs",
    "test:e2e:visual": "playwright test e2e/visual-capture.spec.mjs e2e/adaptive-visual.spec.mjs e2e/forms-visual.spec.mjs e2e/environment-visual.spec.mjs e2e/experience-studio-visual.spec.mjs --workers=1 --timeout=90000",
    "qa:visual-evidence:verify": "node scripts/verify-visual-evidence.mjs",
    "qa:accessibility-evidence:verify": "node scripts/axe-evidence.mjs",
    "qa:accessibility-evidence:stash": "node scripts/transfer-accessibility-reports.mjs stash",
    "qa:accessibility-evidence:restore": "node scripts/transfer-accessibility-reports.mjs restore",
    "pretest:e2e:firefox": "npm run release:foundations:verify",
    "test:e2e:firefox": "playwright test e2e/foundations-packaged.spec.mjs e2e/gc-ui.spec.mjs e2e/adaptive.spec.mjs e2e/forms.spec.mjs e2e/forms-solid-contrast.spec.mjs e2e/validation-summary.spec.mjs e2e/density-preview.spec.mjs e2e/composited-contrast.spec.mjs e2e/effective-zoom.spec.mjs e2e/pattern-workbench.spec.mjs --browser firefox --workers=1",
    "test:e2e:accessibility": "playwright test e2e/accessibility.spec.mjs --workers=1",
    "pack:check": "node scripts/check-pack-manifest.mjs",
    "test:e2e:reflow": "playwright test e2e/reflow.spec.mjs --workers=1",
    "test:e2e:effective-zoom": "playwright test e2e/effective-zoom.spec.mjs --workers=1",
    "qa:native-zoom:chromium": "GC_ZOOM_ISOLATED_DISPLAY=1 XDG_SESSION_TYPE=x11 GDK_BACKEND=x11 MOZ_ENABLE_WAYLAND=0 xvfb-run -a -s '-screen 0 1440x900x24' node scripts/qa-real-browser-zoom.mjs chromium",
    "qa:native-zoom:firefox": "GC_ZOOM_ISOLATED_DISPLAY=1 XDG_SESSION_TYPE=x11 GDK_BACKEND=x11 MOZ_ENABLE_WAYLAND=0 xvfb-run -a -s '-screen 0 1440x900x24' node scripts/qa-real-browser-zoom.mjs firefox",
    "test:native:contracts": "node --test tests/native-host.test.mjs native/desktop/test/host-contract.test.mjs native/desktop/test/local-resource-policy.test.mjs tests/native-adapters.test.mjs",
    "qa:native:desktop": "xvfb-run -a node native/desktop/electron-smoke.mjs",
    "test:android:performance:parsers": "python3 -m unittest discover -s scripts -p test_qa_android_performance.py",
    "test:android:compositor:parsers": "python3 -m unittest discover -s scripts -p test_qa_android_compositor.py",
    "test:android:gpu:parsers": "python3 -m unittest discover -s scripts -p test_qa_android_gpu.py",
    "test:desktop:atspi:parsers": "python3 -m unittest discover -s scripts -p test_qa_electron_atspi.py",
    "qa:desktop:atspi": "xvfb-run -a dbus-run-session -- /usr/bin/python3 scripts/qa-electron-atspi.py",
    "test:android:perfetto:parsers": "python3 -m unittest discover -s scripts -p test_qa_android_perfetto.py",
    "test:desktop:orca:parsers": "python3 -m unittest discover -s scripts -p test_qa_orca_speech.py",
    "qa:desktop:orca:generated-speech": "xvfb-run -a dbus-run-session -- /usr/bin/python3 scripts/qa-orca-speech.py",
    "test:android:power-readiness:parsers": "python3 -m unittest discover -s scripts -p test_qa_android_power_readiness.py",
    "qa:android:power-readiness": "python3 scripts/qa-android-power-readiness.py",
    "qa:desktop:portability": "node scripts/check-desktop-portability.mjs",
    "qa:native:desktop:direct": "node native/desktop/electron-smoke.mjs",
    "release:foundations:build": "node scripts/build-foundations-candidate.mjs",
    "release:foundations:verify": "node scripts/verify-foundations-candidate.mjs",
    "release:foundations:types": "npm exec --yes --package typescript@5.9.3 -- tsc --project dist/foundations-verify/consumer/tsconfig.json",
    "release:foundations:stable:build": "node scripts/build-foundations-candidate.mjs --stable",
    "release:foundations:stable:verify": "node scripts/verify-foundations-candidate.mjs --stable",
    "authority:check": "node scripts/check-design-authority.mjs",
    "migration:audit": "node scripts/audit-legacy-consumer.mjs",
    "migration:reconcile:check": "node scripts/check-consumer-reconciliation.mjs",
    "release:foundations:handoff:verify": "node scripts/verify-foundations-handoff.mjs",
    "migration:cutover:readiness": "node scripts/check-cutover-readiness.mjs",
    "migration:handoff:check": "node scripts/render-consumer-migration-handoff.mjs --check",
    "migration:handoff:render": "node scripts/render-consumer-migration-handoff.mjs --stdout",
    "release:foundations:registry:readback": "node scripts/verify-npm-registry-distribution.mjs"
  },
  "license": "Apache-2.0",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./tokens": "./tokens/gc.v1.tokens.json",
    "./css/tokens": "./styles/gc.v1.generated.css",
    "./css/components": "./styles/gc.v1.components.css",
    "./icons": "./assets/gc-glyphs.svg",
    "./registry": "./registry/components.v1.json",
    "./css/navigation": "./styles/gc.v1.navigation.css",
    "./brand/icon": "./assets/gc-mark.svg",
    "./brand/symbol": "./assets/gc-symbol.svg",
    "./brand/logo": "./assets/gc-logo.svg",
    "./brand/logo-dark": "./assets/gc-logo-dark.svg",
    "./css/materials": "./styles/gc.v1.materials.css",
    "./css/patterns": "./styles/gc.v1.patterns.css",
    "./assets/third-party-glyphs": "./assets/third-party/gc-third-party-glyphs.svg",
    "./registry/third-party-assets": "./registry/third-party-assets.v1.json",
    "./integrations/motion": "./integrations/optional-motion.mjs",
    "./css/depth": "./styles/gc.v1.depth.css",
    "./assets/scenes": "./assets/gc-scenes.svg",
    "./native/host-client": "./src/gc-native-host.mjs"
  },
  "files": [
    "src",
    "types",
    "styles/gc.v1.generated.css",
    "styles/gc.v1.components.css",
    "tokens/gc.v1.tokens.json",
    "assets/gc-glyphs.svg",
    "README.md",
    "docs",
    "registry/components.v1.json",
    "styles/gc.v1.navigation.css",
    "assets/gc-mark.svg",
    "assets/gc-symbol.svg",
    "assets/gc-logo.svg",
    "assets/gc-logo-dark.svg",
    "styles/gc.v1.materials.css",
    "styles/gc.v1.patterns.css",
    "assets/third-party",
    "registry/third-party-assets.v1.json",
    "integrations",
    "styles/gc.v1.depth.css",
    "assets/gc-scenes.svg"
  ],
  "sideEffects": [
    "./styles/*.css"
  ]
}
