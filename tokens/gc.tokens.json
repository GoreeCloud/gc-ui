{
  "meta": {
    "name": "GoreeCloud UI",
    "status": "alpha candidate values; roles and material layers follow founder-approved standard",
    "version": "0.1.0-alpha.0",
    "philosophy": "Clear by default. Consistent by nature. Fluid by design.",
    "materials": [
      "Cloud Canvas",
      "Cloud Surface",
      "Cloud Lens"
    ],
    "license": "MIT",
    "format": "goreecloud-ui-alpha-1"
  },
  "foundations": {
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "12px",
      "md": "18px",
      "lg": "26px",
      "xl": "36px",
      "full": "9999px"
    },
    "type": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Consolas, monospace",
      "display": "clamp(2.75rem, 4.5vw, 4.375rem)",
      "title": "clamp(1.75rem, 3vw, 2.25rem)",
      "section": "1.5rem",
      "heading": "1.125rem",
      "body": "1rem",
      "support": "0.875rem",
      "label": "0.8125rem",
      "lineBody": "1.55"
    },
    "motion": {
      "fast": "120ms",
      "base": "220ms",
      "slow": "380ms",
      "ease": "cubic-bezier(.2,.8,.2,1)",
      "expressive": "cubic-bezier(.16,1,.3,1)"
    },
    "elevation": {
      "zero": "none",
      "one": "0 3px 12px rgba(22,28,49,.07)",
      "two": "0 10px 32px rgba(22,28,49,.13)",
      "three": "0 20px 56px rgba(22,28,49,.2)",
      "four": "0 28px 72px rgba(22,28,49,.25)"
    },
    "breakpoint": {
      "compact": "600px",
      "medium": "900px",
      "expanded": "1200px"
    },
    "z": {
      "base": 0,
      "sticky": 10,
      "dropdown": 30,
      "lens": 40,
      "dialog": 80,
      "toast": 100
    },
    "icon": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px",
      "xl": "32px",
      "stroke": "1.8"
    },
    "size": {
      "control": "44px",
      "controlLarge": "52px",
      "touch": "44px"
    },
    "blur": {
      "lens": "20px"
    },
    "opacity": {
      "disabled": "0.48"
    },
    "content": {
      "readable": "74ch",
      "wide": "1320px"
    }
  },
  "semantic": {
    "light": {
      "canvas": "#F6F7FB",
      "surface": "#FFFFFF",
      "surface-tonal": "#EEF0F7",
      "text": "#1B2030",
      "text-soft": "#505B70",
      "outline": "#68758C",
      "outline-soft": "#CED3DF",
      "positive": "#166B4B",
      "on-positive": "#FFFFFF",
      "warning": "#955000",
      "on-warning": "#FFFFFF",
      "negative": "#B3261E",
      "on-negative": "#FFFFFF",
      "lens-fill": "rgba(255,255,255,.84)",
      "lens-solid": "#FFFFFF",
      "scrim": "rgba(12,18,32,.52)",
      "focus-ring": "#2346CA"
    },
    "dark": {
      "canvas": "#0D121D",
      "surface": "#171D2A",
      "surface-tonal": "#252D3D",
      "text": "#F2F4FB",
      "text-soft": "#CED5E5",
      "outline": "#9CA8BC",
      "outline-soft": "#505B70",
      "positive": "#95E0BB",
      "on-positive": "#0D271D",
      "warning": "#FFCE83",
      "on-warning": "#332000",
      "negative": "#FFB4AB",
      "on-negative": "#4F1410",
      "lens-fill": "rgba(30,38,53,.86)",
      "lens-solid": "#242C3B",
      "scrim": "rgba(0,0,0,.64)",
      "focus-ring": "#BFCBFF"
    }
  },
  "accents": {
    "iris": {
      "light": {
        "brand": "#5146C8",
        "on-brand": "#FFFFFF",
        "brand-container": "#E8E5FF",
        "on-brand-container": "#30266F"
      },
      "dark": {
        "brand": "#BFB8FF",
        "on-brand": "#272057",
        "brand-container": "#413974",
        "on-brand-container": "#E8E5FF"
      }
    },
    "lagoon": {
      "light": {
        "brand": "#00697A",
        "on-brand": "#FFFFFF",
        "brand-container": "#C4F2F4",
        "on-brand-container": "#064D58"
      },
      "dark": {
        "brand": "#8BE7F1",
        "on-brand": "#003A42",
        "brand-container": "#19525B",
        "on-brand-container": "#D7FAFF"
      }
    },
    "ember": {
      "light": {
        "brand": "#A43F1D",
        "on-brand": "#FFFFFF",
        "brand-container": "#FFE1D4",
        "on-brand-container": "#76270F"
      },
      "dark": {
        "brand": "#FFB79F",
        "on-brand": "#4E1E0D",
        "brand-container": "#713922",
        "on-brand-container": "#FFE1D4"
      }
    },
    "moss": {
      "light": {
        "brand": "#326B42",
        "on-brand": "#FFFFFF",
        "brand-container": "#D5F3D9",
        "on-brand-container": "#1B502C"
      },
      "dark": {
        "brand": "#A9E0B3",
        "on-brand": "#173B20",
        "brand-container": "#33553B",
        "on-brand-container": "#DBF7DF"
      }
    }
  }
}
