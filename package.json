{
  "name": "@goreecloud/ui",
  "version": "0.1.0-alpha.0",
  "description": "GoreeCloud UI foundations, semantic tokens and accessible progressive web components",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./tokens": "./tokens/gc.tokens.json",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./icons": "./src/icons.js",
    "./theme": "./src/theme.js"
  },
  "files": [
    "src/",
    "tokens/",
    "docs/",
    "registry/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check src/index.js && node --check src/theme.js && node --check src/icons.js && node --check src/elements.js && npm test"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
